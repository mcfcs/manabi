# ── App server ────────────────────────────────────────────────────────────
# Dev compose maps the container to host port 56661 (avoids other programs' ports)
DATABASE_URL=postgresql+asyncpg://manabi:manabi@localhost:56661/manabi
# Sync URL used by Alembic and Procrastinate admin operations (psycopg 3)
DATABASE_URL_SYNC=postgresql+psycopg://manabi:manabi@localhost:56661/manabi
SECRET_KEY=change-me-generate-a-long-random-string
FILE_STORAGE_ROOT=./storage
# Public origin of the app (used for Origin-check CSRF and signed URLs)
APP_ORIGIN=https://manabi.local

# ── AI node (phillmyeol) — set these in the .env ON that machine ─────────
# The GPU worker reaches the app server's Postgres over Tailscale.
# Use the MagicDNS name, never a hardcoded IP.
# DATABASE_URL=postgresql+asyncpg://manabi_gpu:<password>@app-server:5432/manabi
# APP_SERVER_URL=https://app-server
# Target architecture: the worker runs ON phillmyeol, so this is localhost.
# While the worker runs on the dev PC instead, point it at phillmyeol over
# Tailscale (MagicDNS): http://phillmyeol:11434
OLLAMA_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen3.5:27b
CHAT_MODEL=qwen2.5vl:7b

# ── Embeddings (run on app server CPU) ───────────────────────────────────
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
